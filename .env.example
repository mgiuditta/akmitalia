# --- Database ---
# In sviluppo l'app gira sull'host e il database in Docker: 127.0.0.1.
# In rilascio con docker-compose l'host del database e' `db`, e la stringa la
# compone il compose da POSTGRES_*: qui basta che i tre valori combacino.
DATABASE_URL=postgres://payload:payload@127.0.0.1:5432/akm
POSTGRES_USER=payload
POSTGRES_PASSWORD=payload
POSTGRES_DB=akm

# --- Applicazione ---
PAYLOAD_SECRET=cambiami
# Origine pubblica del sito: serve a canonical, sitemap e JSON-LD.
# In Docker viene letta al momento del build, non all'avvio.
NEXT_PUBLIC_SITE_URL=https://www.akmitalia.it
# Porta pubblicata dal container. Solo per docker-compose.
PORTA=3000

# --- Posta ---
# SMTP per l'avviso email delle richieste dal form /contatti.
# Vuoti in sviluppo: la richiesta si salva comunque e la mail finisce nel log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@akm-italia.eu
